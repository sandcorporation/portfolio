# 운영 .env 예시. 실제 파일은 Jenkins 워크스페이스(oracle 호스트의
# /var/jenkins_home/workspace/portfolio/.env)에만 둔다. 저장소에 넣지 않는다.

# Django
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_ALLOWED_HOSTS=sandcorp.co.kr,www.sandcorp.co.kr
DJANGO_CSRF_TRUSTED_ORIGINS=https://sandcorp.co.kr,https://www.sandcorp.co.kr
# Django admin 경로(추측하기 어려운 값, 끝의 / 생략 가능)
DJANGO_ADMIN_PATH=change-me-admin-path
# 임시 admin 로그인 제한(#25): X-Forwarded-For를 덧붙이는 프록시 단계 수(NPMplus 1개 = 1). 임시 로그인 제거(#7 후속)와 함께 뺀다.
ADMIN_LOGIN_PROXY_HOPS=1
# sitemap.xml 절대 URL 기준 (생략하면 https://sandcorp.co.kr)
SITE_URL=https://sandcorp.co.kr
# sandcorp-auth 대표 username. 이 값과 같은 sub의 액세스 토큰만 /mcp·관리 API를 쓴다.
# 비워 두면 사이트는 뜨고 /mcp는 503.
AUTH_OWNER_SUB=
# sandcorp-auth admin에 등록한 이 사이트의 기밀 클라이언트(관리 화면 로그인).
# 리다이렉트 URI는 {SITE_URL}/{DJANGO_ADMIN_PATH}/oauth/callback/ 로 등록한다.
# 비워 두면 「sandcorp-auth로 로그인」만 503이고 사이트·임시 로그인은 그대로.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# DJANGO_LOG_LEVEL=INFO
# GUNICORN_WORKERS=2

# Postgres (compose의 postgres 서비스와 web이 같이 읽는다)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# web 바인딩(기본: oracle 덮어쓰기에서 172.17.0.1:18091)
# HTTP_BIND=172.17.0.1
# HTTP_PORT=18091

# 오브젝트 스토리지: OCI S3 호환 API. 비워 두면 사이트는 뜨고 미디어 업로드만 막힌다.
# STORAGE_ENDPOINT_URL=https://<namespace>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
# STORAGE_REGION=ap-chuncheon-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BUCKET=
# STORAGE_PRIVATE_BUCKET=
# 공개 객체 URL 접두(끝 / 생략 가능). 객체 키가 뒤에 붙는다.
# STORAGE_PUBLIC_BASE_URL=https://objectstorage.ap-chuncheon-1.oraclecloud.com/n/<namespace>/b/<공개 버킷>/o/
