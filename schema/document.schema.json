    "TableBlock": {
      "additionalProperties": false,
      "description": "A header row and data rows, with an optional highlighted column, unit and footnotes.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "table",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "columns": {
          "description": "Header row",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "description": "A cell is a string, or an object when it spans columns or rows. The rows must fill the grid exactly: a row lists only the cells that start in it, so the columns a cell above reaches with rowspan are left out of the rows below.",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/TableCell"
                }
              ]
            },
            "type": "array"
          },
          "type": "array"
        },
        "highlight_column": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Zero-based index of the emphasised column. A merged cell is emphasised when it covers that column."
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit note, e.g. '단위: 만원'"
        },
        "footnotes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "columns",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "description": "A cell that spans several columns or rows, or aligns differently from its column.",
      "properties": {
        "text": {
          "type": "string"
        },
        "colspan": {
          "default": 1,
          "description": "Columns covered, starting at this cell",
          "minimum": 1,
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "description": "Rows covered, starting at this row",
          "minimum": 1,
          "type": "integer"
        },
        "align": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "VideoBlock": {
      "additionalProperties": false,
      "description": "A video with an optional poster image and caption.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "video",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "media_id": {
          "description": "Id of an uploaded video (private in proposals)",
          "minimum": 1,
          "type": "integer"
        },
        "poster_media_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of an image shown before playing"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allow_download": {
          "default": false,
          "description": "Show a download button for the video file",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in by the server when the document is served; never stored."
        },
        "poster_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in by the server when the document is served; never stored."
        }
      },
      "required": [
        "id",
        "type",
        "media_id"
      ],
      "title": "VideoBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A block document: tabs of blocks. Shared by public pages, portfolio and proposals.",
  "properties": {
    "tabs": {
      "items": {
        "$ref": "#/$defs/Tab"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "tabs"
  ],
  "title": "Document",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
