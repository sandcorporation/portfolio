{
  "$defs": {
    "AudioCompareBlock": {
      "additionalProperties": false,
      "description": "One original recording and the tracks separated from it, played in one player so the\nlistener can switch tracks at the same moment. Each track may carry its transcript and the\noriginal script side by side; an optional metrics table sums up the results.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "audio-compare",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How to listen, one paragraph"
        },
        "original": {
          "$ref": "#/$defs/AudioTrack"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/AudioTrack"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricsTable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "original",
        "tracks"
      ],
      "title": "AudioCompareBlock",
      "type": "object"
    },
    "AudioTrack": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "description": "Id of an uploaded audio file (private in proposals)",
          "minimum": 1,
          "type": "integer"
        },
        "label": {
          "description": "e.g. '원음 · 두 화자 혼합', '화자 A · 분리 결과'",
          "minLength": 1,
          "type": "string"
        },
        "transcript": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What speech-to-text made of this track (변환한 글)"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The original script to compare the transcript with (원래 대본)"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in by the server when the document is served; never stored."
        }
      },
      "required": [
        "media_id",
        "label"
      ],
      "title": "AudioTrack",
      "type": "object"
    },
    "CalloutBlock": {
      "additionalProperties": false,
      "description": "A boxed note: information, a warning, or a condition the reader must accept.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "callout",
          "type": "string"
        },
        "kind": {
          "enum": [
            "info",
            "warning",
            "condition"
          ],
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body": {
          "description": "Markdown (GFM)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "body"
      ],
      "title": "CalloutBlock",
      "type": "object"
    },
    "CaseRefBlock": {
      "additionalProperties": false,
      "description": "Portfolio cases cited by reference, in the given order. A published revision carries the\ncases as they read at publish time.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "case-ref",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CaseRefItem"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "CaseRefBlock",
      "type": "object"
    },
    "CaseRefItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "description": "Id of a portfolio item (hidden items allowed): the `id` of `list_portfolio`. Not the slug: slugs change.",
          "minimum": 1,
          "type": "integer"
        },
        "highlight": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Emphasis line for this proposal; replaces the item's summary when set."
        },
        "case": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The item's content. Never stored in a draft: the server fills it from the current portfolio when serving a draft or preview, and freezes it into a published revision."
        }
      },
      "required": [
        "item_id"
      ],
      "title": "CaseRefItem",
      "type": "object"
    },
    "CaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "description": "The portfolio item's address when this was filled in",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "period": {
          "default": "",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cover_url": {
          "default": "",
          "description": "Public URL of the cover image; empty if none",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title"
      ],
      "title": "CaseSnapshot",
      "type": "object"
    },
    "CoverBlock": {
      "additionalProperties": false,
      "description": "Opening of a document: who it is for, its title and a short subtitle.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "cover",
          "type": "string"
        },
        "recipient": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "받는 사람, e.g. '홍길순 대표님께'"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "title"
      ],
      "title": "CoverBlock",
      "type": "object"
    },
    "CtaBlock": {
      "additionalProperties": false,
      "description": "One to three link buttons that move the reader to another block or tab of this document,\nor to an outside address. On paper they become link text. Not in the table of contents.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "cta",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CtaItem"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "CtaBlock",
      "type": "object"
    },
    "CtaItem": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Button text, one short line",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "block": "#/$defs/CtaTargetBlock",
              "tab": "#/$defs/CtaTargetTab",
              "url": "#/$defs/CtaTargetUrl"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CtaTargetBlock"
            },
            {
              "$ref": "#/$defs/CtaTargetTab"
            },
            {
              "$ref": "#/$defs/CtaTargetUrl"
            }
          ]
        },
        "style": {
          "default": "primary",
          "enum": [
            "primary",
            "secondary"
          ],
          "type": "string"
        }
      },
      "required": [
        "label",
        "target"
      ],
      "title": "CtaItem",
      "type": "object"
    },
    "CtaTargetBlock": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "block",
          "type": "string"
        },
        "block_id": {
          "description": "A block of this document; opens its tab and scrolls to it",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "block_id"
      ],
      "title": "CtaTargetBlock",
      "type": "object"
    },
    "CtaTargetTab": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tab",
          "type": "string"
        },
        "tab_id": {
          "description": "A tab of this document",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tab_id"
      ],
      "title": "CtaTargetTab",
      "type": "object"
    },
    "CtaTargetUrl": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "url",
          "type": "string"
        },
        "href": {
          "description": "Only https:, mailto: or tel: addresses; opens in a new window",
          "pattern": "^(https://|mailto:|tel:)\\S+$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "href"
      ],
      "title": "CtaTargetUrl",
      "type": "object"
    },
    "DetailsBlock": {
      "additionalProperties": false,
      "description": "Supplementary explanation, collapsed until the reader opens it.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "details",
          "type": "string"
        },
        "summary": {
          "description": "Always-visible line that opens the body",
          "minLength": 1,
          "type": "string"
        },
        "body": {
          "description": "Markdown (GFM)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "summary",
        "body"
      ],
      "title": "DetailsBlock",
      "type": "object"
    },
    "EmbedBlock": {
      "additionalProperties": false,
      "description": "A live page of our own Flow site in an iframe (the \"try it\" demo). The address is limited\nto that one host; the page tells its height by postMessage. On paper it is a link line.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "embed",
          "type": "string"
        },
        "src": {
          "description": "https address on flow.sandcorp.co.kr only, e.g. https://flow.sandcorp.co.kr/try?embed=1&template=home (no theme: the page adds it)",
          "pattern": "^https://flow\\.sandcorp\\.co\\.kr(/\\S*)?$",
          "type": "string"
        },
        "title": {
          "description": "Accessible name of the frame",
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "intro": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One line shown above the frame"
        },
        "open_label": {
          "default": "새 탭에서 열기",
          "description": "Text of the link",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "src",
        "title"
      ],
      "title": "EmbedBlock",
      "type": "object"
    },
    "GalleryBlock": {
      "additionalProperties": false,
      "description": "Images in a grid; selecting one opens a larger viewer. Proposals may use private media.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "gallery",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/GalleryImage"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "images"
      ],
      "title": "GalleryBlock",
      "type": "object"
    },
    "GalleryImage": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "description": "Id of an uploaded image. Private media only in proposal documents.",
          "minimum": 1,
          "type": "integer"
        },
        "alt": {
          "description": "Text for readers who cannot see the image",
          "minLength": 1,
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Filled in by the server when the document is served; never stored."
        }
      },
      "required": [
        "media_id",
        "alt"
      ],
      "title": "GalleryImage",
      "type": "object"
    },
    "HtmlBlock": {
      "additionalProperties": false,
      "description": "Exception only: markup no other block can express. Sanitized on storage (allow-list).",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "html",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section heading, listed in the TOC"
        },
        "level": {
          "default": 2,
          "description": "Heading level of the title",
          "enum": [
            2,
            3
          ],
          "type": "integer"
        },
        "html": {
          "description": "HTML limited to text, lists, tables, links and figures. Scripts, event attributes, style, images, iframes and non-http(s)/mailto/tel URLs are removed when stored.",
          "maxLength": 50000,
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "html"
      ],
      "title": "HtmlBlock",
      "type": "object"
    },
    "KpiBlock": {
      "additionalProperties": false,
      "description": "Two to four headline figures shown as cards.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "kpi",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/KpiItem"
          },
          "maxItems": 4,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "KpiBlock",
      "type": "object"
    },
    "KpiItem": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "description": "Shown as written, e.g. '5,950만원'",
          "minLength": 1,
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "보조 문구 under the value"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "KpiItem",
      "type": "object"
    },
    "MarkdownBlock": {
      "additionalProperties": false,
      "description": "Prose. Its title (with a heading level) is what the table of contents is built from.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "markdown",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section heading, listed in the TOC"
        },
        "level": {
          "default": 2,
          "description": "Heading level of the title",
          "enum": [
            2,
            3
          ],
          "type": "integer"
        },
        "body": {
          "default": "",
          "description": "Markdown (GFM). Raw HTML is not rendered.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "MarkdownBlock",
      "type": "object"
    },
    "MetricsTable": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "description": "Header row",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "description": "Same cell rules as the table block: a string, or an object to merge cells",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/TableCell"
                }
              ]
            },
            "type": "array"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How to read the figures"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "MetricsTable",
      "type": "object"
    },
    "StepItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique within the block",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "title": {
          "description": "The step's name, one short line",
          "minLength": 1,
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short markdown under the title"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Small note, e.g. who does it or how long"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "StepItem",
      "type": "object"
    },
    "StepsBlock": {
      "additionalProperties": false,
      "description": "An ordered flow of 2-8 steps joined by arrows (e.g. script -> voice -> video). Horizontal\nlayout folds into a vertical one on narrow screens and on paper beyond four steps.",
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "type": {
          "const": "steps",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Listed in the table of contents"
        },
        "layout": {
          "default": "horizontal",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "type": "string"
        },
        "numbered": {
          "default": true,
          "description": "Show a step number badge",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/StepItem"
          },
          "maxItems": 8,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "title": "StepsBlock",
      "type": "object"
    },
    "Tab": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique within the document. Partial edits address blocks by this id.",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "audio-compare": "#/$defs/AudioCompareBlock",
                "callout": "#/$defs/CalloutBlock",
                "case-ref": "#/$defs/CaseRefBlock",
                "cover": "#/$defs/CoverBlock",
                "cta": "#/$defs/CtaBlock",
